# TokUp 环境变量配置

# 管理员账号（首次启动必填）
TOKUP_ADMIN_EMAIL=admin@tokup.io
TOKUP_ADMIN_PASSWORD=Admin123456

# JWT 密钥（可选，不设置会自动生成）
TOKUP_SECRET_KEY=

# 支付渠道（支持：mock | manual | payjs | custom）
PAY_CHANNEL=mock

# 手动收款（最稳定，零依赖 — 用你的个人支付宝/微信收款码）
MANUAL_ALIPAY_QR=https://your-domain.com/qr/alipay.jpg
MANUAL_WECHAT_QR=https://your-domain.com/qr/wechat.jpg

# PayJS (payjs.cn) — 仅微信支付，个人可用
PAYJS_MCHID=
PAYJS_KEY=
PAYJS_URL=https://payjs.cn/api/native

# 自定义支付渠道
CUSTOM_API_URL=
CUSTOM_APP_ID=
CUSTOM_APP_KEY=
CUSTOM_SIGN_TYPE=md5

# 部署域名（支付回调必填）
TOKUP_BASE_URL=http://localhost:3000

# AI API 密钥（代理转发）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# 安全护盾级别（low | medium | high | paranoid）
TOKUP_SECURITY_LEVEL=high
